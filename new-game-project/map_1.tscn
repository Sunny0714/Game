script = ExtResource("4_n2bu5")

[node name="TutorialText18" type="Label" parent="." unique_id=1377764857]
offset_left = 18501.0
offset_top = -449.0
offset_right = 19325.0
offset_bottom = -294.0
theme_override_font_sizes/font_size = 55
text = "Press 'esc' and then \"Skip\"
to finish the tutorial"
script = ExtResource("4_n2bu5")

[node name="TutorialText2" type="Label" parent="." unique_id=1302372736]
offset_left = 1892.0
offset_top = -509.0
offset_right = 2635.0
offset_bottom = -239.0
theme_override_font_sizes/font_size = 55
text = "I'll guide you through your
four abilities and show you 
how to interact with items."
script = ExtResource("4_n2bu5")

[node name="TutorialText3" type="Label" parent="." unique_id=1439592324]
offset_left = 2907.0
offset_top = -602.0
offset_right = 3966.0
offset_bottom = 27.0
theme_override_font_sizes/font_size = 55
text = "First, let's talk about Energy.

Every time you hit an enemy,
you gain Energy. When your
 Energy reaches its maximum,
your Energy Bar will begin to glow,
letting you know your Ultimate is ready.
"
script = ExtResource("4_n2bu5")

[node name="TutorialText5" type="Label" parent="." unique_id=552816935]
offset_left = 4075.0
offset_top = -445.0
offset_right = 5291.0
offset_bottom = -21.0
theme_override_font_sizes/font_size = 55
text = "Now it's time to learn your *Basic Attack*.

Your Basic Attack, Spark, chains
between nearby enemies. 'Left Click' to use it.
"
script = ExtResource("4_n2bu5")

[node name="TutorialText6" type="Label" parent="." unique_id=781156123]
offset_left = 6277.0
offset_top = -611.0
offset_right = 7660.0
offset_bottom = -61.0
theme_override_font_sizes/font_size = 55
text = "Your second ability is your *Energy Ability*.

Using it costs *25 Energy*. 
Your Lightning Energy 
Ability is called Conductor. 
Press 'Shift' to activate it.
"
script = ExtResource("4_n2bu5")

[node name="TutorialText7" type="Label" parent="." unique_id=1860761641]
offset_left = 7675.0
offset_top = -633.0
offset_right = 8537.0
offset_bottom = -162.0
theme_override_font_sizes/font_size = 55
text = "Conductor creates a wall 
with *500 HP* that deals 
damage to enemies upon 
death. It also lets your 
attacks chain even when 
only one enemy is nearby."
script = ExtResource("4_n2bu5")

[node name="TutorialText17" type="Label" parent="." unique_id=1810324557]
offset_left = 8657.0
offset_top = -258.0
offset_right = 8953.0
offset_bottom = -173.0
theme_override_font_sizes/font_size = 55
text = "Place here"
script = ExtResource("4_n2bu5")

[node name="TutorialText4" type="Label" parent="." unique_id=258368434]
offset_left = 8902.0
offset_top = -432.0
offset_right = 9020.0
offset_bottom = -311.0
theme_override_font_sizes/font_size = 55
text = "Try"
script = ExtResource("4_n2bu5")

[node name="Dummy3" parent="." unique_id=541256055 instance=ExtResource("3_1q0j8")]
position = Vector2(5676, -88)

[node name="TutorialText8" type="Label" parent="." unique_id=762645291]
offset_left = 5744.0
offset_top = -348.0
offset_right = 5862.0
offset_bottom = -227.0
theme_override_font_sizes/font_size = 55
text = "Try"
script = ExtResource("4_n2bu5")

[node name="TutorialText9" type="Label" parent="." unique_id=1784610475]
offset_left = 9515.0
offset_top = -673.0
offset_right = 10819.0
offset_bottom = -123.0
theme_override_font_sizes/font_size = 55
text = "Great job! Now it's time to learn your *Ultimate*.

Your Ultimate consumes
your entire Energy Bar, but 
it's your most powerful ability. 
Use it wisely!
"
script = ExtResource("4_n2bu5")

[node name="TutorialText10" type="Label" parent="." unique_id=640090236]
offset_left = 10954.0
offset_top = -586.0
offset_right = 12387.0
offset_bottom = -162.0
theme_override_font_sizes/font_size = 55
text = "Press 'E' to unleash your Ultimate, *God Speed*.

You'll move at incredible speed,
damaging every enemy you pass through.
"
script = ExtResource("4_n2bu5")

[node name="TutorialText12" type="Label" parent="." unique_id=1940024828]
offset_left = 13948.0
offset_top = -593.0
offset_right = 15098.0
offset_bottom = -43.0
theme_override_font_sizes/font_size = 55
text = "Nice! You've learned the basics,
but there's still a little more to cover.

Every element has a *Passive Ability*.
Some passives must be activated manually,
while others work automatically.
"
script = ExtResource("4_n2bu5")

[node name="TutorialText13" type="Label" parent="." unique_id=1619414734]
offset_left = 15342.0
offset_top = -573.0
offset_right = 16401.0
offset_bottom = -102.0
theme_override_font_sizes/font_size = 55
text = "Since you chose Lightning, 
you have two Passives.

You move faster than other elements 
and can *Dash* by pressing 'Space'.
"
script = ExtResource("4_n2bu5")

[node name="TutorialText14" type="Label" parent="." unique_id=921092044]
offset_left = 16625.0
offset_top = -587.0
offset_right = 18062.0
offset_bottom = -116.0
theme_override_font_sizes/font_size = 55
text = "One last thing!
Defeated enemies have a chance to drop useful items.

To pick one up, simply 'Right Click' on it.
"
script = ExtResource("4_n2bu5")

