[node name="TutorialText16" type="Label" parent="." unique_id=2035729663]
offset_left = -412.0
offset_top = -346.0
offset_right = 412.0
offset_bottom = -191.0
theme_override_font_sizes/font_size = 55
text = "Press 'esc' and then \"Skip\"
