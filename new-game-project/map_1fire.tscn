[node name="TutorialText" type="Label" parent="Text" unique_id=216900555]
offset_left = 646.0
offset_top = -500.0
offset_right = 1639.0
offset_bottom = -208.0
theme_override_font_sizes/font_size = 55
text = "Welcome to the tutorial!

You've chosen the Fire element."
script = ExtResource("4_3otti")

[node name="TutorialText15" type="Label" parent="Text" unique_id=517965912]
offset_left = -199.0
offset_top = -478.0
offset_right = 203.0
offset_bottom = -392.0
theme_override_font_sizes/font_size = 55
text = "WASD to MOVE"
script = ExtResource("4_3otti")

[node name="TutorialText16" type="Label" parent="Text" unique_id=2035729663]
offset_left = -412.0
offset_top = -346.0
offset_right = 412.0
offset_bottom = -191.0
theme_override_font_sizes/font_size = 55
text = "Press 'esc' and then \"Skip\"
to skip the tutorial"
script = ExtResource("4_3otti")

[node name="TutorialText17" type="Label" parent="Text" unique_id=784901540]
offset_left = 1434.0
offset_top = 379.0
offset_right = 2598.0
offset_bottom = 534.0
theme_override_font_sizes/font_size = 55
text = "NOTE: DUMMIES DO NOT TAKE KNOCKBACK"
script = ExtResource("4_3otti")

[node name="TutorialText18" type="Label" parent="Text" unique_id=1377764857]
offset_left = 18732.0
offset_top = -449.0
offset_right = 19556.0
offset_bottom = -294.0
theme_override_font_sizes/font_size = 55
text = "Press 'esc' and then \"Skip\"
to finish the tutorial"
script = ExtResource("4_3otti")

[node name="TutorialText2" type="Label" parent="Text" unique_id=1302372736]
offset_left = 1892.0
offset_top = -509.0
offset_right = 2635.0
offset_bottom = -239.0
theme_override_font_sizes/font_size = 55
text = "I'll guide you through your
four abilities and show you 
how to interact with items."
script = ExtResource("4_3otti")

[node name="TutorialText3" type="Label" parent="Text" unique_id=1439592324]
offset_left = 2907.0
offset_top = -602.0
offset_right = 3966.0
offset_bottom = 27.0
theme_override_font_sizes/font_size = 55
text = "First, let's talk about Energy.

Every time you hit an enemy,
you gain Energy. When your
 Energy reaches its maximum,
your Energy Bar will begin to glow,
letting you know your Ultimate is ready.
"
script = ExtResource("4_3otti")

[node name="TutorialText5" type="Label" parent="Text" unique_id=552816935]
offset_left = 4075.0
offset_top = -445.0
offset_right = 5291.0
offset_bottom = -21.0
theme_override_font_sizes/font_size = 55
text = "Now it's time to learn your *Basic Attack*.

Your Basic Attack, Fireball, burns
enemies 'Left Click' to use it.
"
script = ExtResource("4_3otti")

[node name="TutorialText6" type="Label" parent="Text" unique_id=781156123]
offset_left = 6277.0
offset_top = -611.0
offset_right = 7660.0
offset_bottom = -61.0
theme_override_font_sizes/font_size = 55
text = "Your second ability is your *Energy Ability*.

Using it costs *25 Energy*. 
Your Fire Energy 
Ability is called Solor Flare. 
Press 'Shift' to activate it.
"
script = ExtResource("4_3otti")

[node name="TutorialText7" type="Label" parent="Text" unique_id=1860761641]
offset_left = 7626.0
offset_top = -517.0
offset_right = 8693.0
offset_bottom = -46.0
theme_override_font_sizes/font_size = 55
text = "Solar Flare summons a blazing
tornado that pulls enemies to its center,
grouping them together while dealing
constant damage."
script = ExtResource("4_3otti")

[node name="TutorialText4" type="Label" parent="Text" unique_id=258368434]
offset_left = 9009.0
offset_top = -521.0
offset_right = 9105.0
offset_bottom = -400.0
theme_override_font_sizes/font_size = 55
text = "Try"
script = ExtResource("4_3otti")

[node name="TutorialText8" type="Label" parent="Text" unique_id=762645291]
offset_left = 5744.0
offset_top = -348.0
offset_right = 5840.0
offset_bottom = -227.0
theme_override_font_sizes/font_size = 55
text = "Try"
script = ExtResource("4_3otti")

[node name="TutorialText9" type="Label" parent="Text" unique_id=1784610475]
offset_left = 9515.0
offset_top = -673.0
offset_right = 10819.0
offset_bottom = -123.0
theme_override_font_sizes/font_size = 55
text = "Great job! Now it's time to learn your *Ultimate*.

Your Ultimate consumes
your entire Energy Bar, but 
it's your most powerful ability. 
Use it wisely!
"
script = ExtResource("4_3otti")

[node name="TutorialText10" type="Label" parent="Text" unique_id=640090236]
offset_left = 10976.0
offset_top = -675.0
offset_right = 12425.0
offset_bottom = -204.0
theme_override_font_sizes/font_size = 55
text = "Press 'E' to unleash your Ultimate,  *Inferno*.

You'll unleash an unstoppable inferno for *4 seconds*.
While it's active, you can't move, but any enemies 
caught in the flames will also be stunned.
"
script = ExtResource("4_3otti")

[node name="TutorialText12" type="Label" parent="Text" unique_id=1940024828]
offset_left = 13948.0
offset_top = -593.0
offset_right = 15098.0
offset_bottom = -43.0
theme_override_font_sizes/font_size = 55
text = "Nice! You've learned the basics,
but there's still a little more to cover.

Every element has a *Passive Ability*.
Some passives must be activated manually,
while others work automatically.
"
script = ExtResource("4_3otti")

[node name="TutorialText13" type="Label" parent="Text" unique_id=1619414734]
offset_left = 15342.0
offset_top = -573.0
offset_right = 16712.0
offset_bottom = -102.0
theme_override_font_sizes/font_size = 55
text = "Since you chose Fire, 
you have one Passives.

You can summon a *Heatwave* by pressing 'Space'.
"
script = ExtResource("4_3otti")

[node name="TutorialText14" type="Label" parent="Text" unique_id=921092044]
offset_left = 16990.0
offset_top = -631.0
offset_right = 18427.0
offset_bottom = -160.0
theme_override_font_sizes/font_size = 55
text = "One last thing!
Defeated enemies have a chance to drop useful items.

To pick one up, simply 'Right Click' on it.
"
script = ExtResource("4_3otti")

[node name="TutorialText11" type="Label" parent="Text" unique_id=1580000861]
offset_left = 13070.0
offset_top = -554.0
offset_right = 13188.0
offset_bottom = -433.0
theme_override_font_sizes/font_size = 55
text = "Try"
script = ExtResource("4_3otti")

